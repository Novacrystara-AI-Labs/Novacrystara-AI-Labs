# ─────────────────────────────────────────────────────────────────────────────
# Discovery-session capture (arch §2, §13). Copy this file to .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# EMAIL DELIVERY (recommended) — leads are emailed via SMTP.
# For Gmail: keep SMTP_HOST/PORT as-is, set SMTP_USER to your Gmail address, and
# set SMTP_PASS to a Google "App Password" (NOT your normal password):
#   Google Account → Security → 2-Step Verification → App passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Where submissions are delivered. Defaults to the current test inbox if unset.
CONTACT_TO=yachamaneniramcharan49@gmail.com

# OPTIONAL: also forward each lead to a webhook (CRM / Slack / scheduler).
# When neither SMTP nor this is set, the /api/contact route validates + logs the
# lead so the form still works locally.
CONTACT_WEBHOOK_URL=
